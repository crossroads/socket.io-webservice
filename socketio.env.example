# socket.io-webservice: Docker env file (template)
#
# Copy to the server, fill in the <placeholders>, and pass it with:  docker run --env-file /path/to/file/socketio.env ...
#
# Keep the filled-in copy out of this repo. The Dockerfile does `COPY . /app`, and
# .dockerignore only excludes `.env`, so any other filled-in env file here would be baked into the image.
#
# No quotes around values: docker --env-file passes them through literally.

# Port the Node process listens on inside the container
PORT=
NODE_ENV=

# --- Redis -------------------------------------------------------------------

# Required. "localhost" inside a container is the container itself, not the server.
# Redis on the docker host: use host.docker.internal (the run command adds it via --add-host)
# and make sure Redis listens on the docker bridge (172.17.0.1), not only on 127.0.0.1.
REDIS_URL=

# Optional. Seconds an offline device's queued messages are kept before it must full-resync.
# Leave unset to use the default of 3600. If set, it is passed to clients as a string, and 0 does not disable it.
# DEVICE_TTL=

# --- Site (the socket.io namespace) --------------------------------
# Required. Setting SITE_NAME replaces sites.yml entirely
SITE_NAME=

# The API endpoint each connecting socket is authenticated against (bearer token from the client).
AUTH_URL=
AUTH_SCHEME=

# Shared secret. Must equal the apiKey= in api.goodcity's SOCKETIO_SERVICE_URL.
API_KEY=

# Rooms starting with this prefix are per-user rooms (user_123, user_123_admin, ...).
USER_ROOM_PREFIX=

# Called on connect/disconnect to record last_connected / last_disconnected. :id is replaced with the user id.
UPDATE_USER_URL=

# Shared room that anonymous browse.goodcity users join.
PUBLIC_CHANNEL=
